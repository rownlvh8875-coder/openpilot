{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Integrated eGPU S2A telemetry-only research policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "minModelSamplesPerLeg",
    "minHardwareSamplesOnLeg",
    "minHardwareValidFraction",
    "maxBaselineP95DriftMs",
    "maxBaselineP99DriftMs",
    "maxTelemetryP50IncreaseMs",
    "maxTelemetryP95IncreaseMs",
    "maxTelemetryP99IncreaseMs",
    "maxAdditionalFrameGaps",
    "maxFallbacksPerLeg",
    "maxGuardViolationsPerLeg",
    "maxHardwareErrorSamples",
    "maxSupplyFaultSamples",
    "maxP95HardwareSampleDurationMs",
    "maxGpuTempC",
    "maxMemoryTempC",
    "maxPowerDrawW"
  ],
  "properties": {
    "minModelSamplesPerLeg": {"type": "integer", "minimum": 1},
    "minHardwareSamplesOnLeg": {"type": "integer", "minimum": 1},
    "minHardwareValidFraction": {"type": "number", "minimum": 0, "maximum": 1},
    "maxBaselineP95DriftMs": {"type": "number", "minimum": 0},
    "maxBaselineP99DriftMs": {"type": "number", "minimum": 0},
    "maxTelemetryP50IncreaseMs": {"type": "number", "minimum": 0},
    "maxTelemetryP95IncreaseMs": {"type": "number", "minimum": 0},
    "maxTelemetryP99IncreaseMs": {"type": "number", "minimum": 0},
    "maxAdditionalFrameGaps": {"type": "integer", "minimum": 0},
    "maxFallbacksPerLeg": {"type": "integer", "minimum": 0},
    "maxGuardViolationsPerLeg": {"type": "integer", "minimum": 0},
    "maxHardwareErrorSamples": {"type": "integer", "minimum": 0},
    "maxSupplyFaultSamples": {"type": "integer", "minimum": 0},
    "maxP95HardwareSampleDurationMs": {"type": "number", "minimum": 0},
    "maxGpuTempC": {"type": ["number", "null"], "exclusiveMinimum": 0},
    "maxMemoryTempC": {"type": ["number", "null"], "exclusiveMinimum": 0},
    "maxPowerDrawW": {"type": ["number", "null"], "exclusiveMinimum": 0}
  }
}
